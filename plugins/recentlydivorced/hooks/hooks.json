{
  "description": "Label Codex resume rows with short conversation summaries.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_DATA}/recentlydivorced --refresh",
            "timeout": 1800,
            "async": true
          }
        ]
      }
    ]
  }
}
