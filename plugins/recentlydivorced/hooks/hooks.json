{
  "description": "Keep Codex resume previews pointed at the latest human prompt.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/recentlydivorced",
            "timeout": 2,
            "async": true,
            "statusMessage": "Updating resume preview"
          }
        ]
      }
    ]
  }
}
